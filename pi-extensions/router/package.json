{
  "name": "@pi-spore/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: the spore/auto router virtual model and the plan usage tap",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
