{
  "name": "pi-spore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local agent workbench for Pi coding agents",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "check": "biome check . && tsc -b",
    "test": "vitest run",
    "format": "biome check --write .",
    "build": "tsc -b && npm run build -w @pi-spore/web",
    "start": "node packages/server/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
